rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow authenticated users to write to their own profile picture files.
    // The file name must contain their UID.
    match /profile-pictures/{fileName} {
      allow write: if request.auth != null && fileName.matches('.*' + request.auth.uid + '.*');
    }
    
    // Allow authenticated users to upload to their profile folder
    match /profiles/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to upload list, hub, and post images
    match /list-images/{fileName} {
      allow write: if request.auth != null;
    }

    match /hub-images/{fileName} {
      allow write: if request.auth != null;
    }

    match /post-images/{fileName} {
      allow write: if request.auth != null;
    }

    // Dev / seed / test / temp paths require auth at minimum. Were
    // previously open to the world (`allow read, write: if true`) which let
    // anyone on the internet write into the bucket — a real abuse vector.
    // Production seeding uses the admin SDK (rules bypassed), so requiring
    // auth here doesn't break the local seed flow.
    match /seed-data/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /test/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /temp/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
