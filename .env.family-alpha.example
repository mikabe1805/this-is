# Copy this file to `.env.family-alpha.local` only after creating a completely
# separate Firebase project for family dogfooding. The local file is ignored.
# Never use `this-is-76332` here.
THIS_IS_FAMILY_ALPHA_PROJECT_ID=your-separate-project-id
VITE_RELEASE_CHANNEL=family-alpha

VITE_FIREBASE_API_KEY=replace-with-alpha-firebase-browser-key
VITE_FIREBASE_AUTH_DOMAIN=your-separate-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-separate-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-separate-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-alpha-sender-id
VITE_FIREBASE_APP_ID=replace-with-alpha-app-id

VITE_USE_FIREBASE_EMULATORS=false
VITE_EMULATOR_PLACES_STUB=false
VITE_PLACES_ENABLED=true
VITE_PLACES_NEW_KEY=replace-with-origin-and-api-restricted-alpha-places-key

# Photos remain dark until a reviewed project-wide budget is configured.
VITE_GROUP_PHOTOS_ENABLED=false
