rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Development mode helper - allows unrestricted access for development and seeding
    function isDevMode() {
      return request.time < timestamp.date(2030, 1, 1); // Enable until 2030 for dev
    }

    // Users collection - Allow read for demo purposes
    match /users/{userId} {
      allow read: if true; // Allow all reads for demo
      allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      
      // User subcollections - Allow read for demo purposes
      match /friends/{friendId} {
        allow read: if true; // Allow all reads for demo
        allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }
      
      match /following/{followingId} {
        allow read: if true; // Allow all reads for demo
        allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }
      
      match /activity/{activityId} {
        allow read: if true; // Allow all reads for demo
        allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }

      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }

      match /savedPlaces/{placeId} {
        allow read: if isAuthenticated();
        allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }

      match /savedLists/{listId} {
        allow read, write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }

      match /comments/{commentId} {
        allow read: if true; // Allow all reads for demo
        allow create: if isAuthenticated();
        allow update, delete: if isDevMode() || (isAuthenticated() && isOwner(resource.data.userId));
      }
    }

    // Places collection - Allow read for demo purposes
    match /places/{placeId} {
      allow read: if true; // Allow all reads for demo
      allow write: if isDevMode() || isAuthenticated();
      allow delete: if isDevMode(); // Allow deletion in dev mode for cleanup

      // Per-user "I saved this place" markers. recordUserSave writes
      // places/{placeId}/saves/{userId} as the source-of-truth for
      // savedCount denormalization. Without this rule the write was
      // silently rejected with a permission error and the global
      // savedCount counter never incremented.
      match /saves/{userId} {
        allow read: if isAuthenticated();
        allow write: if isDevMode() || (isAuthenticated() && isOwner(userId));
      }
    }

    // Hubs collection
    match /hubs/{hubId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Or more restrictive rules
    }

    // Lists collection - Allow read for demo purposes
    match /lists/{listId} {
      allow read: if true; // Allow all reads for demo
      allow write: if isDevMode() || (isAuthenticated() && isOwner(resource.data.userId));
      allow delete: if isDevMode() || (isAuthenticated() && isOwner(resource.data.userId));
      
      // Allow authenticated users to add places to lists
      match /places/{placeId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Allow authenticated users to add posts to lists.
      // Read was missing — getPostsForList iterates this subcollection to
      // discover which posts belong to a list, so without `allow read` the
      // ListModal hit "Missing or insufficient permissions" on every open.
      match /posts/{postId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Posts collection - Allow read for demo purposes
    match /posts/{postId} {
      allow read: if true; // Allow all reads for demo
      allow write: if isDevMode() || (isAuthenticated() && isOwner(resource.data.userId));
      allow delete: if isDevMode() || (isAuthenticated() && isOwner(resource.data.userId));

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Allow all reads for demo
        allow create: if isAuthenticated();
        allow update, delete: if isDevMode() || (isAuthenticated() && isOwner(resource.data.userId));
      }
    }

    // 1:1 message threads. The thread id is a deterministic sort-join of
    // both participant ids (`<aId>__<bId>`), so collisions across the two
    // sides are impossible. Read/write is restricted to participants.
    match /threads/{threadId} {
      allow read: if isAuthenticated()
        && resource != null
        && request.auth.uid in resource.data.participants;
      // Create needs the requester to be in the participants array of the
      // INCOMING doc (resource isn't readable yet at create time).
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated()
        && resource != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false; // threads aren't user-deletable in this version

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/threads/$(threadId)).data.participants.hasAny([request.auth.uid]);
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.senderId
          && get(/databases/$(database)/documents/threads/$(threadId)).data.participants.hasAny([request.auth.uid]);
        // Messages are append-only — no edits / deletes for this MVP.
        allow update, delete: if false;
      }
    }

    // Tags collection - Allow read for all users, write for authenticated users
    match /tags/{tagId} {
      allow read: if true; // Allow all reads so users can see available tags
      allow write: if isAuthenticated(); // Allow authenticated users to create/update tags
    }

    // UserTags collection - personality tags
    match /userTags/{tagId} {
      allow read: if true; // Allow all reads so clients can fetch relevant tags
      allow write: if isAuthenticated(); // Allow authenticated users to create/update their own tags
    }

    // User preferences collection - Allow read/write for demo purposes
    match /userPreferences/{userId} {
      allow read: if true; // Allow all reads for demo
      allow write: if true; // Allow all writes for demo
    }

    // Analytics collection - Allow writes for demo purposes
    match /analytics/{document=**} {
      allow create: if true; // Allow all writes for demo
      allow read: if false; // Only backend should read analytics
    }

    // Cache: Places query responses (24h TTL) - readable by all, write-only by backend (admin SDK)
    match /placesCache/{key} {
      allow read: if true;
      allow write: if false; // Functions write via admin SDK (rules bypassed)
    }

    // Cache: Maps cell responses (24h TTL)
    match /mapsCells/{key} {
      allow read: if true;
      allow write: if false; // Functions write via admin SDK
    }

    // Test collection - Allow all operations for development
    match /test-collection/{document=**} {
      allow read, write: if isDevMode(); // Only allow in dev mode
    }

    // Development/Seed data - Allow all operations
    match /seed-data/{document=**} {
      allow read, write: if isDevMode(); // Only allow in dev mode
    }
  }
}
