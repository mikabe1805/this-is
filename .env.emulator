# Tracked local-development mode. Every identifier is deliberately fake/demo-only.
VITE_FIREBASE_API_KEY=fake
VITE_FIREBASE_AUTH_DOMAIN=demo-this-is-v2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-this-is-v2
VITE_FIREBASE_STORAGE_BUCKET=demo-this-is-v2.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATORS=true

# Local development never spends Google quota. Production-mode emulator browser
# verification injects its own same-origin Places stub explicitly.
VITE_EMULATOR_PLACES_STUB=false
VITE_PLACES_ENABLED=false
VITE_PLACES_NEW_KEY=emulator-only-no-google
VITE_GROUP_PHOTOS_ENABLED=false
