rules_version = '2';

// this.is v2 — default-deny, real from day one. No isDevMode, no 2030 backdoor.
//
// NOT DEPLOYED: the repo-root firestore.rules is what serves the project today
// (with an isDevMode dev backdoor that must be removed before launch). THIS file
// is the friend-graph cutover target (v2/FRIENDS.md): graft these blocks into the
// deployed ruleset, remove the dev backdoor, then delete v1's blocks once the old
// hosting target retires. Do not deploy casually — deploying replaces the whole
// ruleset and v1 is still serving.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profiles: handle, displayName, avatarHex, and the `following` array.
    // Readable by any signed-in user so friends resolve each other's name and
    // avatar in the feed.
    match /users/{uid} {
      allow read: if signedIn();
      // The owner writes their whole doc.
      allow write: if isOwner(uid);
      // An invite is a MUTUAL follow (addMutualFollow), so a signed-in user must
      // be able to append THEMSELVES to another user's `following` — and nothing
      // else: only the `following` field may change, and the only uid added is
      // the caller's own. (Residual: a caller could still truncate the target's
      // list; closing that fully needs a callable/Cloud Function — roadmap
      // Next-#2. This constrained rule keeps the invite loop client-side and is
      // strictly tighter than the isDevMode backdoor it replaces.)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following'])
        && request.auth.uid in request.resource.data.following;
    }

    // THE FRIEND GRAPH — flat top-level saves, keyed {uid}__g:{pid} (the
    // connective tissue so the feed is one query). INTERIM read posture: any
    // signed-in user (scoping reads to the follow-graph is roadmap Next-#3 and
    // needs a fan-out / readableBy model, not a rules one-liner). Owner-only
    // writes; delete must check the EXISTING doc (request.resource is null on
    // delete).
    match /saves/{saveId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // The shared place catalog: g:{place_id} docs. Readable by anyone; written
    // only by signed-in users (and only inside the save path — browsing never
    // writes, enforced by code).
    match /places/{placeId} {
      allow read: if true;
      allow create, update: if signedIn();
    }

    // The CURATED catalog and the geo-cell candidate pools — the discovery
    // scaffold. Public read; writes are Admin-SDK only (the seed scripts run
    // privileged), never from a client.
    match /curated/{placeId} {
      allow read: if true;
      allow write: if false;
    }
    match /cities/{cityKey}/candidates/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // Baked share snapshots: public read, function-only write.
    match /shares/{token} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
